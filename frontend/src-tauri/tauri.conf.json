{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Miting",
  "version": "1.0.0",
  "identifier": "li.bigde.miting",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3118",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Miting",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light",
        "decorations": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: https://asset.localhost data:",
        "connect-src": "'self' http://localhost:11434 http://localhost:5167 http://localhost:8178 https://api.ollama.ai asset: https://asset.localhost",
        "media-src": "'self' blob: asset: https://asset.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$AUDIO/miting-recordings/**",
          "$AUDIO/meetily-recordings/**",
          "$VIDEO/miting-recordings/**",
          "$DOCUMENT/miting-recordings/**"
        ]
      },
      "capabilities": [
        {
          "identifier": "main",
          "description": "Main window capability with file system and media access",
          "windows": [
            "main"
          ],
          "permissions": [
            "fs:default",
            "fs:allow-read-file",
            "fs:read-all",
            "fs:write-all",
            "fs:allow-app-read",
            "fs:allow-app-write",
            "fs:allow-download-write",
            "fs:allow-download-read",
            "fs:scope-download",
            "core:path:default",
            "core:event:default",
            "core:window:default",
            "core:app:default",
            "core:resources:default",
            "core:menu:default",
            "core:tray:default",
            "core:window:allow-set-title",
            "store:default",
            "notification:default",
            "notification:allow-is-permission-granted",
            "updater:default",
            "process:default",
            {
              "identifier": "fs:scope",
              "allow": [
                {
                  "path": "$APPDATA/*"
                }
              ]
            }
          ]
        }
      ],
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: https://asset.localhost data: blob:",
        "connect-src": "'self' ws://localhost:3118 http://localhost:3118 http://localhost:11434 http://localhost:5167 http://localhost:8178 https://api.ollama.ai asset: https://asset.localhost",
        "media-src": "'self' blob: asset: https://asset.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "msi",
      "nsis",
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "templates/*.json",
      "resources/extension"
    ],
    "externalBin": [
      "binaries/llama-helper",
      "binaries/ffmpeg",
      "binaries/miting-pairing-host",
      "binaries/shenava-helper"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "windows": {
      "signCommand": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -FilePath %1"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1QUE2NEJENTBDM0UyRQpSV1F1UGd6VlM2WmFBdDNmcklETGpzRDVDcGxITUZ3b3FsZGVzdkYvQk1PU2FOaFNzeUlEbXBzMAo=",
      "endpoints": [
        "https://github.com/mbigdeli/miting/releases/latest/download/latest.json"
      ]
    }
  }
}
